/*
plugins
*/
plugins {
    id 'nf-schema@~2.5.0'
    id 'nf-prov@1.5.0'
}
/*
tool configs
*/
includeConfig './conf/tools/bbduk.config'
//bbduk
includeConfig './conf/tools/cutadapt.config'
// cutadapt
includeConfig './conf/tools/fastp.config'
// fastp
includeConfig './conf/tools/flexbar.config'
// flexbar
includeConfig './conf/tools/kraken2.config'
// kraken2
includeConfig './conf/tools/shoji.config'
// shoji
includeConfig './conf/tools/sourmash.config'
// sourmash
includeConfig './conf/tools/STAR.config'
// STAR
includeConfig './conf/tools/tracks.config'
// tracks
includeConfig './conf/tools/umi_tools.config'
// umi_tools
includeConfig './conf/tools/gatk.config'
// GATK
/*
default output directory
can be overridden by params.outdir
*/
outputDir = '/path/to/output/dir'
/*
provenance config
see: https://github.com/nextflow-io/nf-prov
commented out for now

prov {
  enabled = true
  formats {
    bco {
      file = 'bco.json'
      overwrite = true
    }
    wrroc {
      file = 'ro-crate-metadata.json'
      overwrite = true
    }
  }
}
*/
manifest {
    name = "clip-seq-workflow"
    author = "Sudeep Sahadevan"
    description = "A Nextflow workflow for  CLIP-seq data processing"
    version = "1.1.1"
    nextflowVersion = ">=25.04.0"
    mainScript = "main.nf"
}
/*
default params
*/
params {

    // placeholder for sample sheet path, should be overridden by CLI or profile
    input = "/path/to/sample_sheet.csv"
    // basic params, MUST BE overridden by protocol/genome profiles
    demultiplex = false
    // whether to demultiplex (for iCLIP)
    dedup = false
    // iCLIP, eCLIP, R2-CLIP
    two_step_trim = false
    // eCLIP only two step trimming
    twopass_mapping = true
    // two pass mapping alignment (STAR), default true
    is_paired = false
    // special case for iCLIP data, not sure how to generalize
    rRNA_trim = true
    // whether to do rRNA trimming, rRNA_trim = false, for rDNA genome alignment
    r2_clip = false
    // perform variant calling
    call_variants = false
    // placeholder for additional parameters
    fa = "/path/to/genome.fa"
    fai = "/path/to/genome.fai"
    gff3 = "/path/to/annotation.gff3"
    rRNA_fa = "/path/to/rRNA.fa"
    STAR_index = "/path/to/STAR/index"
    // bbduk
    bbduk.ref = params.rRNA_fa
    // STAR
    STAR.genomeDir = params.STAR_index
    // shoji
    shoji.gff3 = params.gff3
    // tracks
    tracks.genome = params.fai
    // output directories
    annotation_dir = "Annotation"
    qc_dir = "QC"
    sourmash_dir = "Sourmash"
    fastq_dir = "Fastq"
    align_dir = "Genome_align"
    variant_dir = "Variants"
    shoji_dir = "Shoji"
    kraken2_dir = "Kraken2/contamination_check"
    stats_dir = "Stats"
}

/*
profiles should include protocol and genome specific configs
MUST BE loaded after tool configs so that protocol/genome specific params can override tool params
*/
// resources
includeConfig "./conf/run/process_resource.config"

profiles {
    /*
    *** WARNING ***
    profiles MUST be loaded after `params{}` declaration above
    so that protocol/genome specific params can override the default params
    */

    slurm {
        includeConfig './conf/run/embl_hd.config'
    }
    // run environments
    local {
        process {
            executor = 'local'
            cpus = 2
            memory = '6 GB'
            maxRetries = 2
        }
        docker {
            enabled = false
        }
    }
    standard {
        process {
            executor = 'local'
            cpus = 2
            memory = '6 GB'
            maxRetries = 2
        }
        docker {
            enabled = false
        }
    }
    apptainer {
        includeConfig './conf/containers/apptainer.config'
        apptainer {
            enabled = true
            autoMounts = true
        }
        conda {
            enabled = false
        }
        docker {
            enabled = false
        }
    }
    // conda specific
    conda {
        includeConfig './conf/conda/conda.config'
        conda {
            enabled = true
            useMamba = true
        }
        apptainer {
            enabled = false
        }
        docker {
            enabled = false
        }
    }

    // protocol
    eCLIP {
        includeConfig './conf/protocol/eCLIP.config'
    }
    iCLIP {
        includeConfig './conf/protocol/iCLIP.config'
    }
    R2CLIP {
        includeConfig './conf/protocol/R2CLIP.config'
    }
    soniCLIP {
        includeConfig './conf/protocol/soniCLIP.config'
    }
    // genome
    hsa {
        includeConfig './conf/genome/hsa.config'
    }
    rDNA {
        includeConfig './conf/genome/rDNA.config'
    }
    rno {
        includeConfig './conf/genome/rno.config'
    }
    // test
    test {
        includeConfig './conf/tests/test.config'
    }
}
