nextflow_workflow {

    name "Test Workflow FASTP"
    script "subworkflows/fastp.nf"
    workflow "FASTP"

    test("Test: FASTP - Subworkflow") {

        when {
            workflow {
                """
                // define inputs of the workflow here. Example:
                in_ch = channel.of(
                    tuple('SLBP_IP',true,params.eCLIP.ip),
                    tuple('SLBP_SMI',true,params.eCLIP.smi),
                )
                input[0] = in_ch
                input[1] = params.fastp.adapters
                input[2] = params.fastp.trim
                input[3] = params.sourmashCfg
                input[4] = 'test'
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }

    }

}
