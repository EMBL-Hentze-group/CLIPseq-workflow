nextflow_workflow {

    name "Test Workflow CUTADAPT_2STEP"
    script "subworkflows/cutadapt_2step.nf"
    workflow "CUTADAPT_2STEP"

    test("Test: CUTADAPT_2STEP - Subworkflow") {

        when {
            workflow {
                """
                // define inputs of the workflow here. Example:
                in_ch = channel.of(
                    tuple('SLBP_IP',true,params.eCLIP.ip),
                    tuple('SLBP_SMI',true,params.eCLIP.smi),
                )
                input[0] = in_ch
                input[1] = params.cutadapt.trim1
                input[2] = params.cutadapt.trim2
                input[3] = params.sourmashCfg
                """
            }
        }

        then {
            assert workflow.success
            assert snapshot(workflow.out).match()
        }

    }

}
