nextflow_process {

    name "Test Process bbduk"
    script "modules/bbduk.nf"
    process "bbduk"

    test("Test: BBDUK - process") {

        when {
            process {
                """
                // define inputs of the process here. Example:
                input[0] = tuple('SLBP_SMI', true, params.eCLIP.smi)
                input[1] = params.bbduk.ref
                input[2] = params.bbduk.params
                """
            }
        }

        then {
            assert process.success
            assert snapshot(process.out).match()
        }

    }

}
