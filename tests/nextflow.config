includeConfig '../nextflow.config'

params {
    // BBDUK: eCLIP test data
    eCLIP.smi = ["${projectDir}/tests/data/Fastq/SLBP_SMI_R1.fq.gz", "${projectDir}/tests/data/Fastq/SLBP_SMI_R2.fq.gz"]
    eCLIP.ip = ["${projectDir}/tests/data/Fastq/SLBP_IP1_R1.fq.gz", "${projectDir}/tests/data/Fastq/SLBP_IP1_R2.fq.gz"]
    // bbduk ref
    bbduk.ref = "${projectDir}/tests/data/Annotations/rRNA_human.fa.gz"
    // sourmash test config
    sourmashCfg = [
        sketch: params.sourmash.sketch,
        abund: params.sourmash.abund,
        comparison_K: params.sourmash.comparison_K,
    ]
    // cutadapt 2 step trimming
    cutadapt.trim1 = " --match-read-wildcards --times 1 -e 0.1 -O 1 --quality-cutoff 6 -m 15 -a NNNNNAGATCGGAAGAGCACACGTCTGAACTCCAGTCAC  -g CTTCCGATCTACAAGTT  -g CTTCCGATCTTGGTCCT  -A AACTTGTAGATCGGA  -A AGGACCAAGATCGGA  -A ACTTGTAGATCGGAA  -A GGACCAAGATCGGAA  -A CTTGTAGATCGGAAG  -A GACCAAGATCGGAAG  -A TTGTAGATCGGAAGA  -A ACCAAGATCGGAAGA  -A TGTAGATCGGAAGAG  -A CCAAGATCGGAAGAG  -A GTAGATCGGAAGAGC  -A CAAGATCGGAAGAGC  -A TAGATCGGAAGAGCG  -A AAGATCGGAAGAGCG  -A AGATCGGAAGAGCGT  -A GATCGGAAGAGCGTC  -A ATCGGAAGAGCGTCG  -A TCGGAAGAGCGTCGT  -A CGGAAGAGCGTCGTG  -A GGAAGAGCGTCGTGT"
    cutadapt.trim2 = "--match-read-wildcards  --times 1  -e 0.1  -O 5  --quality-cutoff 6  -m 15  -A AACTTGTAGATCGGA  -A AGGACCAAGATCGGA  -A ACTTGTAGATCGGAA  -A GGACCAAGATCGGAA  -A CTTGTAGATCGGAAG  -A GACCAAGATCGGAAG  -A TTGTAGATCGGAAGA  -A ACCAAGATCGGAAGA  -A TGTAGATCGGAAGAG  -A CCAAGATCGGAAGAG  -A GTAGATCGGAAGAGC  -A CAAGATCGGAAGAGC  -A TAGATCGGAAGAGCG  -A AAGATCGGAAGAGCG  -A AGATCGGAAGAGCGT  -A GATCGGAAGAGCGTC  -A ATCGGAAGAGCGTCG  -A TCGGAAGAGCGTCGT  -A CGGAAGAGCGTCGTG  -A GGAAGAGCGTCGTGT"
    // fastp trim
    fastp.trim = "--disable_trim_poly_g -q 6 -l 15 -a NNNNNAGATCGGAAGAGCACACGTCTGAACTCCAGTCAC   -a CTTCCGATCTACAAGTT   -a CTTCCGATCTTGGTCCT   --adapter_sequence_r2 AACTTGTAGATCGGA   --adapter_sequence_r2 AGGACCAAGATCGGA   --adapter_sequence_r2 ACTTGTAGATCGGAA   --adapter_sequence_r2 GGACCAAGATCGGAA   --adapter_sequence_r2 CTTGTAGATCGGAAG   --adapter_sequence_r2 GACCAAGATCGGAAG   --adapter_sequence_r2 TTGTAGATCGGAAGA   --adapter_sequence_r2 ACCAAGATCGGAAGA   --adapter_sequence_r2 TGTAGATCGGAAGAG   --adapter_sequence_r2 CCAAGATCGGAAGAG   --adapter_sequence_r2 GTAGATCGGAAGAGC   --adapter_sequence_r2 CAAGATCGGAAGAGC   --adapter_sequence_r2 TAGATCGGAAGAGCG   --adapter_sequence_r2 AAGATCGGAAGAGCG   --adapter_sequence_r2 AGATCGGAAGAGCGT   --adapter_sequence_r2 GATCGGAAGAGCGTC   --adapter_sequence_r2 ATCGGAAGAGCGTCG   --adapter_sequence_r2 TCGGAAGAGCGTCGT   --adapter_sequence_r2 CGGAAGAGCGTCGTG   --adapter_sequence_r2 GGAAGAGCGTCGTGT"
    // shoji create sliding windows params
    shoji.gff3 = "${projectDir}/tests/data/Annotations/gencode.v42.chr6.gff3.gz"
    // shoji extract params
    shoji.mate = 2
    shoji.site = "s"
    shoji.offset = -1
    // shoji count params
    sliding_windows = "${projectDir}/tests/data/Annotations/gencode.v42.chr6.gff3.bed_w100_s20.bed.gz"
    bam = "${projectDir}/tests/data/Bams/SLBP_SMI_subset.bam"
    bai = "${projectDir}/tests/data/Bams/SLBP_SMI_subset.bam.bai"
    extract_params = "-q ${params.shoji.qual} --min_aln_len ${params.shoji.aln_len} --aln_frac ${params.shoji.aln_frac} --n_aln ${params.shoji.n_aln}"
    // deduplication and to_fastq input
    dedup_bam = "${projectDir}/tests/data/Bams/SLBP_SMI_DUP.bam"
    dedup_bai = "${projectDir}/tests/data/Bams/SLBP_SMI_DUP.bam.bai"
    // tracks input
    sites = "${projectDir}/tests/data/Bams/SLBP_SMI_chr6_sites.bed.gz"
    tracks.genome = "${projectDir}/tests/data/Annotations/chr6.fa.fai"
    // genome indexing
    gi.fa_gz = "${projectDir}/tests/data/Annotations/chr6_mask_subset.fa.gz"
    gi.fa = "${projectDir}/tests/data/Annotations/chrM.fa"
    // Variant calling
    cims.bam = "${projectDir}/tests/data/Bams/IP_CIMS.bam"
    cims.bai = "${projectDir}/tests/data/Bams/IP_CIMS.bam.bai"
    cims.fa = params.gi.fa_gz
    cims.fai = "${projectDir}/tests/data/Annotations/chr6_mask_subset.fa.gz.fai"
    cims.gzi = "${projectDir}/tests/data/Annotations/chr6_mask_subset.fa.gz.gzi"
    cims.dict = "${projectDir}/tests/data/Annotations/chr6_mask_subset.dict"
    Mutect2.run_params = "--dont-use-soft-clipped-bases --enable-dynamic-read-disqualification-for-genotyping --kmer-size 8 --kmer-size 10 --kmer-size 15 --kmer-size 25 --kmer-size 30 --active-probability-threshold 0.001 --max-reads-per-alignment-start 0 --pcr-indel-model NONE -DF MappingQualityNotZeroReadFilter -DF NotDuplicateReadFilter --init-lod 1.0 --f1r2-min-bq 10"
    FilterMutectCalls.run_params = "--lenient --max-alt-allele-count 10 --f-score-beta 1.0 --min-median-base-quality 10"
}
