/*
Genome build: Rat
*/

params {
    //fasta & co
    fa = "/path/to/genome.fa"
    fai = "/path/to/genome.fa.fai"
    rRNA_fa = "/path/to/rRNA.fa"
    // annotation
    gff3 = "/path/to/genome.annotation.gff3"
    // index
    STAR_index = "/path/to/STAR_index"
    // bbduk
    bbduk.ref = params.rRNA_fa
    // STAR
    STAR.genomeDir = params.STAR_index
    // shoji
    shoji.gff3 = params.gff3
    shoji.annotation_params = "--gene_id gene_id --gene_name Name --gene_type biotype -x tRNA"
    // tracks
    tracks.genome = params.fai
}
