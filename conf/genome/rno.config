/*
Genome build: Rat, ENSEMBL mRatBN7.2
*/

params {
    //fasta & co
    fa = "/g/hentze/sequencing/genomes/Rat_norvegicus/ENSEMBL_2024/Rattus_norvegicus.mRatBN7.2.dna.toplevel.fa"
    fai = "/g/hentze/sequencing/genomes/Rat_norvegicus/ENSEMBL_2024/Rattus_norvegicus.mRatBN7.2.dna.toplevel.fa.fai"
    rRNA_fa = "/g/hentze/sequencing/rRNA/Rat/Rat_rRNA_sequences.fa"
    // annotation
    gff3 = "/g/hentze/sequencing/genomes/Rat_norvegicus/ENSEMBL_2024/Rattus_norvegicus.mRatBN7.2.111.tRNA.gff3"
    // index
    STAR_index = "/g/hentze/sequencing/genomes/Rat_norvegicus/ENSEMBL_2024/STAR_wo_VCF"
    // bbduk
    bbduk.ref = params.rRNA_fa
    // STAR
    STAR.genomeDir = params.STAR_index
    // shoji
    shoji.gff3 = params.gff3
    shoji.annotation_params = "--gene_id gene_id --gene_name Name --gene_type biotype -x tRNA"
    // tracks
    tracks.genome = params.fai
}
