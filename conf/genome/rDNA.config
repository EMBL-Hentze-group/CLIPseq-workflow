/*
Genome build: Human, gencode Hg38 v42 primary assembly
*/
params {
    //fasta & co
    fai = "/path/to/genome.fa.fai"
    rRNA_fa = "/path/to/rRNA.fa"
    // annotation
    gff3 = "/path/to/genome.annotation.gff3"
    // index
    STAR_index = "/g/hentze/sequencing/rDNA_masked_hg38_genome/Index/v2.7.11/GTF_wo_scaffolds/"
    // bbduk
    bbduk.ref = params.rRNA_fa
    // STAR
    STAR.genomeDir = params.STAR_index
    // shoji
    shoji.gff3 = params.gff3
    shoji.annotation_params = "--gene_id gene_id --gene_name gene_name --gene_type gene_type --gene_id gene_id --gene_name gene_name --gene_type gene_type -x tRNA -x rRNA"
    // tracks
    tracks.genome = params.fai
    // Skip rRNA trimming
    rRNA_trim = false
}
