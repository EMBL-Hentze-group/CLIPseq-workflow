params {

    shoji.gff3 = "/path/to/gffs"
    shoji.gff3 = params.gff3
    shoji.annotation_params = "--gene_id gene_id --gene_name gene_name --gene_type gene_type -x tRNA"
    shoji.split_intron = true
    shoji.window = 100
    shoji.step = 20
    shoji.ignore_pcr_duplicates = false
    shoji.primary = true
    shoji.mate = 1
    shoji.site = "m"
    shoji.offset = 0
    shoji.qual = 0
    shoji.aln_len = 20
    shoji.aln_frac = 0.90
    shoji.n_aln = 10
    shoji.baseName = "Shoji_analysis_matrix"
    shoji.suffix = ".parquet"
}
