/*
GATK suite configuration
Since GATK suite has multiple utilities, this config file provides default run parameters for each of them.
*/

params {
    AddOrReplaceReadGroups.run_params = "-RGLB lib1 -RGPL Illumina -RGPU unit1"
    SplitNCigarReads.run_params = ""
    BaseRecalibrator.run_params = ""
    ApplyBQSR.run_params = ""
    HaplotypeCaller.run_params = ""
    Mutect2.run_params = ""
    LearnReadOrientationModel.run_params = ""
    FilterMutectCalls.run_params = ""
}
