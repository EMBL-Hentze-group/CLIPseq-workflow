params {

    kraken2.db = "/path/to/kraken2/db"
    kraken2.nodes = "/path/to/kraken2/db/nodes.dmp"
    kraken2.names = "/path/to/kraken2/db/names.dmp"
    /*
    kraken2.nodes and names files: see https://ftp.ncbi.nlm.nih.gov/pub/taxonomy/taxdump_readme.txt
    */
    kraken2.kraken2_params = "--use-names --confidence 0.5"
    kraken2.mpa_params = "--display-header --percentages --keep-spaces"
}
