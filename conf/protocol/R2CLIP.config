params {
    demultiplex = false
    // for R2CLIP
    bc_pattern = "NNNNNNNN"
    // 8nt UMI, complete read2
    dedup = true
    two_step_trim = false
    twopass_mapping = true
    // two pass mapping alignment (STAR)
    min_read_length = 15
    r2_clip = true
    // special case for R2-CLIP, use all of read2 as UMI
    fastp.trim = "-a AAAAAAAAAA --trim_poly_g --trim_poly_x --trim_front1 1 -q 6 -L --low_complexity_filter --overrepresentation_analysis"
    fastp.adapters = "${projectDir}/data/adapters/generic_adapters.fa"
    //  STAR
    STAR.align_params = " --readFilesCommand zcat --outFilterMultimapScoreRange 1 --outFilterType BySJout --genomeLoad NoSharedMemory --outSAMattributes All --outFilterMultimapNmax 10 --outStd BAM_Unsorted --outSAMtype BAM Unsorted --chimSegmentMin 15 --chimMultimapNmax 20 --outSAMunmapped Within"
    //  shoji
    shoji.mate = 1
    shoji.site = "s"
    shoji.offset = 0
    shoji.baseName = "R2CLIP"
    // Variant calling
    call_variants = true
    Mutect2.run_params = "--dont-use-soft-clipped-bases --enable-dynamic-read-disqualification-for-genotyping --kmer-size 8 --kmer-size 10 --kmer-size 15 --kmer-size 25 --kmer-size 30 --active-probability-threshold 0.001 --max-reads-per-alignment-start 0 --pcr-indel-model NONE -DF MappingQualityNotZeroReadFilter -DF NotDuplicateReadFilter --init-lod 1.0 --f1r2-min-bq 10"
    FilterMutectCalls.run_params = "--lenient --max-alt-allele-count 10 --f-score-beta 1.0 --min-median-base-quality 10"
}
